{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "//": "웹 루트는 www/ (index.html + js + css 만 포함). 규칙·설정·소스 원본은 루트에 두고 배포하지 않는다.",
    "public": "www",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "파일명에 해시가 없으므로 max-age를 길게 주면 수정이 하루 동안 반영되지 않는다. no-cache는 매번 ETag로 확인만 하고 변경 없으면 304라 트래픽 부담도 없다.",
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
