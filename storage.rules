rules_version = '2';

/* =========================================================
   BuilderOffice Storage 보안 규칙

   ⚠️ 한계: Storage 규칙은 Firestore를 조회할 수 없어, 여기서
      "이 사용자가 이 회사 소속인가"를 검증할 방법이 없다.
      따라서 아래는 "인증된 사용자"까지만 막는다.
      완전한 회사 격리가 필요하면 Auth 커스텀 클레임(토큰에 companyId)을
      발급하는 백엔드(Cloud Functions)를 붙인 뒤,
      request.auth.token.companyId == companyId 조건으로 강화해야 한다.
      (지금 이 앱은 프런트엔드 전용이라 그 단계는 보류)
   ========================================================= */

service firebase.storage {
  match /b/{bucket}/o {

    // 회사 문서/사진
    match /companies/{companyId}/{allPaths=**} {

      // 인증된 사용자만 읽기
      allow read: if request.auth != null;

      // 업로드: 20MB 이하 + 허용 형식(이미지/PDF/엑셀)만
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (
             request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/vnd.openxmlformats.*')
          || request.resource.contentType.matches('application/vnd.ms-excel')
        );

      // 삭제도 인증 필요
      allow delete: if request.auth != null;
    }

    // 그 외 경로는 전면 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
